<h1 class="h3 mb-4"><%= t(".title") %></h1>

<% if @market_rate&.set? && @max_borrowable_eur.positive? %>
  <p class="text-muted mb-3">
    <%= t(".reserve_balance_html",
      max_amount: tag.strong(format_eur_amount(@max_borrowable_eur)),
      sats: format_sats(Budgets::ReserveRequirement.available_sats_for(current_user)),
      rate: number_with_delimiter(@market_rate.btc_eur_per_btc)) %>
  </p>
<% end %>

<div class="card">
  <div class="card-body">
    <%= form_with model: @budget, url: budgets_path do |f| %>
      <% if @budget.errors.any? %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% @budget.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :amount_eur, t(".form.amount"), class: "form-label" %>
        <%= f.number_field :amount_eur,
          value: @budget.amount_eur_cents ? @budget.amount_eur : nil,
          class: "form-control",
          step: 0.01,
          min: 0.01,
          max: (@max_borrowable_eur.positive? ? @max_borrowable_eur : nil),
          required: true %>
        <div class="form-text">
          <%= t(".form.amount_help") %>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <%= f.label :period_start, t(".form.period_start"), class: "form-label" %>
          <%= f.date_field :period_start, class: "form-control", required: true %>
        </div>
        <div class="col-md-6 mb-3">
          <%= f.label :period_end, t(".form.period_end"), class: "form-label" %>
          <%= f.date_field :period_end, class: "form-control", required: true %>
        </div>
      </div>

      <%= f.submit t(".form.submit"), class: "btn btn-primary" %>
      <%= link_to t("common.actions.cancel"), root_path, class: "btn btn-link" %>
    <% end %>
  </div>
</div>
