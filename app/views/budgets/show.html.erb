<h1 class="h3 mb-4">Ricarica</h1>

<div class="card mb-4">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start mb-3">
      <div>
        <h2 class="h5 mb-1">Ricarica #<%= @budget.id %></h2>
        <%= budget_status_badge(@budget) %>
      </div>
    </div>

    <dl class="row mb-0">
      <dt class="col-sm-3">Richiedente</dt>
      <dd class="col-sm-9"><%= @budget.borrower.name %></dd>
      <dt class="col-sm-3">Investitore</dt>
      <dd class="col-sm-9"><%= @budget.investor&.name || "—" %></dd>
      <dt class="col-sm-3">Importo richiesto</dt>
      <dd class="col-sm-9"><%= format_eur(@budget.amount_eur_cents) %></dd>
      <dt class="col-sm-3">Collateral richiedente</dt>
      <dd class="col-sm-9">
        <% if @budget.borrower_locked_sats.positive? %>
          <%= format_sats(@budget.borrower_locked_sats) %> (<%= format_eur(@budget.amount_eur_cents) %>) — non rimborsato
        <% else %>
          —
        <% end %>
      </dd>
      <dt class="col-sm-3">Collateral investitore</dt>
      <dd class="col-sm-9">
        <% if @budget.investor_locked_sats.positive? %>
          <%= format_sats(@budget.investor_locked_sats) %> (<%= format_eur(@budget.collateral_eur_cents) %>) — rischio FX
        <% else %>
          <%= format_eur(@budget.collateral_eur_cents) %> — in attesa di attivazione
        <% end %>
      </dd>
      <% if @budget.peg_set? %>
        <dt class="col-sm-3">Peg BTC/€</dt>
        <dd class="col-sm-9"><%= number_with_delimiter(@budget.peg_eur_per_btc) %> €/BTC</dd>
      <% elsif @market_rate.set? %>
        <dt class="col-sm-3">Peg BTC/€</dt>
        <dd class="col-sm-9">
          <%= number_with_delimiter(@market_rate.btc_eur_per_btc) %> €/BTC
          <span class="text-muted small">(cambio attuale — fissato all'attivazione)</span>
        </dd>
      <% end %>
      <dt class="col-sm-3">Periodo</dt>
      <dd class="col-sm-9"><%= @budget.period_start %> – <%= @budget.period_end %></dd>
      <% if @budget.genesis_block_height %>
        <dt class="col-sm-3">Blocchi deal</dt>
        <dd class="col-sm-9">
          <%= number_with_delimiter(@budget.genesis_block_height) %> – <%= number_with_delimiter(@budget.maturity_block_height) %>
          <% if @budget.active? %>
            (<%= number_with_delimiter(@budget.blocks_remaining) %> rimanenti, altezza corrente <%= number_with_delimiter(ChainState.block_height) %>)
          <% end %>
        </dd>
      <% end %>
      <% if @budget.active? && @market_rate.set? %>
        <% ltv = @budget.loan_to_value_ratio(@market_rate.btc_eur_per_btc) %>
        <dt class="col-sm-3">LTV corrente</dt>
        <dd class="col-sm-9"><%= budget_ltv_badge(@budget, @market_rate.btc_eur_per_btc) %></dd>
      <% end %>
      <% if @budget.l1_multisig_provisioned? %>
        <dt class="col-sm-3">Collateral lock L1</dt>
        <dd class="col-sm-9">
          <code><%= @budget.escrow_outpoint %></code>
          <% if @budget.recovery_package.dig("escrow", "address") %>
            <span class="text-muted small d-block"><%= @budget.recovery_package.dig("escrow", "address") %></span>
          <% end %>
        </dd>
        <dt class="col-sm-3">Pubkeys (2-of-2)</dt>
        <dd class="col-sm-9">
          <span class="text-muted small d-block">peg: <code><%= truncate_hex(@budget.peg_party_pubkey) %></code></span>
          <span class="text-muted small d-block">investor: <code><%= truncate_hex(@budget.investor_pubkey) %></code></span>
        </dd>
      <% elsif @budget.active? %>
        <dt class="col-sm-3">Escrow L1</dt>
        <dd class="col-sm-9"><span class="text-warning">Non provisionato</span></dd>
      <% end %>
      <% if @budget.dlc_contract.present? %>
        <% dlc = @budget.dlc_contract %>
        <dt class="col-sm-3">Contratto DLC (2-of-2)</dt>
        <dd class="col-sm-9">
          <span class="text-muted small d-block">funding {peg, investor}: <code><%= dlc.funding_outpoint %></code></span>
          <span class="text-muted small d-block">stato: <code><%= dlc.status %></code></span>
          <span class="text-muted small d-block">oracle event: <code><%= dlc.oracle_event_id %></code> (<%= dlc.num_digits %> digit, <%= dlc.unit %>)</span>
        </dd>
        <% if @budget.dlc_settlement&.executed? %>
          <% st = @budget.dlc_settlement %>
          <dt class="col-sm-3">Settlement DLC</dt>
          <dd class="col-sm-9">
            <span class="text-muted small d-block">CET txid: <code><%= truncate_hex(st.cet_txid) %></code></span>
            <span class="text-muted small d-block">
              outcome: <%= number_with_delimiter(st.outcome) %> €/BTC ·
              peg_pot: <%= format_sats(st.peg_pot_sats) %> ·
              investor: <%= format_sats(st.investor_sats) %>
            </span>
            <% if @budget.recovery_package.dig("dlc_distribution", "txid") %>
              <span class="text-muted small d-block">distribuzione: <code><%= truncate_hex(@budget.recovery_package.dig("dlc_distribution", "txid")) %></code></span>
            <% end %>
          </dd>
        <% end %>
      <% end %>
    </dl>
    <% if @budget.recovery_package.present? && (admin? || @budget.borrower_id == current_user.id || @budget.investor_id == current_user.id) %>
      <div class="mt-3 pt-3 border-top">
        <%= link_to "Scarica recovery package (JSON)", budget_recovery_package_path(@budget),
          class: "btn btn-sm btn-outline-primary",
          data: { turbo: false } %>
        <span class="text-muted small ms-2">MULTISIG-SPEC §6 — deal params, outpoint, refund locktime</span>
      </div>
    <% end %>
  </div>
</div>

<% if @budget.pending? && @budget.borrower_id != current_user.id && @market_rate.set? %>
  <div class="card mb-4 border-warning">
    <div class="card-header bg-warning-subtle">Accetta e collateralizza</div>
    <div class="card-body">
      <p class="mb-3">
        Peg al momento dell'attivazione: <strong><%= number_with_delimiter(@market_rate.btc_eur_per_btc) %> €/BTC</strong>
        <span class="text-muted small">(cambio corrente)</span>
      </p>
      <p class="text-muted mb-3">
        <% investor_required_sats = Budgets::ReserveRequirement.investor_sats_for(@budget, @market_rate.btc_eur_per_btc) %>
        <% investor_available_sats = Budgets::ReserveRequirement.available_sats_for(current_user) %>
        Dal conto di riserva verranno decurtati
        <strong><%= format_sats(investor_required_sats) %></strong>
        (collateral <%= format_eur(@budget.collateral_eur_cents) %>, inclusa fee stimata funding L1).
        Disponibili sul conto: <strong><%= format_sats(investor_available_sats) %></strong>.
      </p>
      <p class="text-muted small mb-3">
        All'attivazione verrà creato un contratto DLC 2-of-2 {peg, investor}
        con settlement vincolato all'oracle su regtest
        (richiede <code>./bin/regtest up</code>).
      </p>
      <%= button_to "Accetta rischio e attiva la richiesta", activate_budget_path(@budget), method: :post, class: "btn btn-warning" %>
    </div>
  </div>
<% end %>

<% if @budget.pending? && @budget.borrower_id == current_user.id %>
  <div class="alert alert-info">In attesa di un investitore.</div>
<% end %>

<% if @budget.pending? && !@market_rate.set? %>
  <div class="alert alert-secondary">In attesa che l'admin imposti il cambio BTC/€ corrente.</div>
<% end %>

<% if @budget.active? %>
  <% if @budget.investor_id == current_user.id && @market_rate.set? && @budget.margin_call_threshold_reached?(@market_rate.btc_eur_per_btc) %>
    <div class="alert alert-warning">
      <strong>Margin call:</strong> LTV ≥ <%= (Budget::MARGIN_CALL_LTV_THRESHOLD * 100).to_i %>%.
      Versa collateral aggiuntivo nel multisig per abbassare il LTV ed evitare la liquidazione automatica al <%= (Budget::LIQUIDATION_LTV_THRESHOLD * 100).to_i %>%.
    </div>
  <% end %>

  <% if @budget.investor_id == current_user.id && @market_rate.set? %>
    <div class="card mb-4 border-secondary">
      <div class="card-header">Versa collateral aggiuntivo</div>
      <div class="card-body">
        <p class="text-muted small">Top-up sullo stesso escrow del deal (simula annex multisig). Riduce il LTV immediatamente.</p>
        <%= form_with url: budget_investor_collateral_deposit_path(@budget), class: "row g-2 align-items-end" do %>
          <div class="col-auto">
            <%= label_tag :amount_eur, "Importo (€)", class: "form-label" %>
            <%= number_field_tag :amount_eur, nil, class: "form-control form-control-sm", step: 0.01, min: 0.01, required: true %>
          </div>
          <div class="col-auto">
            <%= submit_tag "Versa", class: "btn btn-sm btn-outline-secondary" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="card mb-4">
    <div class="card-header">Token in circolazione</div>
    <div class="table-responsive">
      <table class="table mb-0">
        <thead>
          <tr>
            <th>Utente</th>
            <th>Saldo EURT</th>
          </tr>
        </thead>
        <tbody>
          <% @budget.token_accounts.includes(:user).where("balance_cents > 0").each do |account| %>
            <tr>
              <td><%= account.user.name %></td>
              <td><%= format_eur(account.balance_cents) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <% if admin? %>
    <div class="d-flex gap-2 mb-4">
      <%= link_to "Settlement fine mese", new_budget_settlement_path(@budget), class: "btn btn-danger" %>
    </div>
  <% end %>
<% end %>

<% if @budget.token_transfers.any? %>
  <div class="card mb-4">
    <div class="card-header">Storico trasferimenti token</div>
    <div class="table-responsive">
      <table class="table mb-0">
        <thead>
          <tr>
            <th>Da</th>
            <th>A</th>
            <th>Importo</th>
            <th>Data</th>
          </tr>
        </thead>
        <tbody>
          <% @budget.token_transfers.includes(:from_user, :to_user).order(created_at: :desc).each do |transfer| %>
            <tr>
              <td><%= transfer.from_user.name %></td>
              <td><%= transfer.to_user.name %></td>
              <td><%= format_eur(transfer.amount_cents) %></td>
              <td><%= l(transfer.created_at, format: :short) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<% if @budget.settlement.present? %>
  <% s = @budget.settlement %>
  <div class="card border-success">
    <div class="card-header bg-success-subtle">Settlement eseguito</div>
    <div class="card-body">
      <p>Cambio corrente fine mese: <strong><%= number_with_delimiter(s.end_btc_eur_rate) %> €/BTC</strong></p>
      <p>Peg budget: <strong><%= number_with_delimiter(@budget.peg_eur_per_btc) %> €/BTC</strong></p>
      <p>BTC ai detentori token: <strong><%= format_sats(s.total_btc_to_holders_sats) %></strong></p>
      <p>BTC a <%= @budget.investor.name %> (residuo collateral): <strong><%= format_sats(s.btc_to_investor_sats) %></strong></p>
    </div>
  </div>
<% end %>

<%= link_to "← Dashboard", root_path, class: "btn btn-link mt-3 px-0" %>
