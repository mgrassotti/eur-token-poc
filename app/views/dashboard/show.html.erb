<% if admin? %><span class="badge text-bg-info mb-4 d-inline-block"><%= t(".admin.badge") %></span><% end %>

<% if admin? %>
  <div class="card mb-4 border-info">
    <div class="card-header bg-info-subtle"><%= t(".admin.panel_title") %></div>
    <div class="card-body">
      <h2 class="h6"><%= t(".admin.chain.title") %></h2>
      <p class="text-muted small mb-3">
        <%= t(".admin.chain.block_height_html", height: number_with_delimiter(@market_rate.bitcoin_block_height)) %>
      </p>

      <%= form_with url: admin_chain_state_path, method: :patch, class: "row g-2 align-items-end mb-4" do %>
        <div class="col-auto">
          <%= label_tag :bitcoin_block_height, t(".admin.chain.field"), class: "form-label" %>
          <%= number_field_tag :bitcoin_block_height,
            @market_rate.bitcoin_block_height,
            class: "form-control form-control-sm",
            min: 0,
            step: 1,
            required: true %>
        </div>
        <div class="col-auto">
          <%= submit_tag t(".admin.chain.submit"), class: "btn btn-sm btn-outline-info" %>
        </div>
      <% end %>

      <h2 class="h6"><%= t(".admin.market_rate.title") %></h2>
      <%= form_with url: admin_market_rate_path, method: :patch, class: "row g-2 align-items-end mb-4" do %>
        <div class="col-auto">
          <%= label_tag :btc_eur_per_btc, "€/BTC", class: "form-label" %>
          <%= number_field_tag :btc_eur_per_btc,
            @market_rate.btc_eur_per_btc || 60_000,
            class: "form-control form-control-sm",
            step: 0.01,
            min: 0.01,
            required: true %>
        </div>
        <div class="col-auto">
          <%= submit_tag t(".admin.market_rate.submit"), class: "btn btn-sm btn-info" %>
        </div>
      <% end %>
      <% if @market_rate.set? %>
        <p class="text-muted small mb-4"><%= t(".admin.market_rate.current_html", rate: number_with_delimiter(@market_rate.btc_eur_per_btc)) %></p>
      <% end %>

      <% if @active_budgets.any? %>
        <h2 class="h6"><%= t(".admin.active_budgets.title") %></h2>
        <ul class="list-group mb-4">
          <% @active_budgets.each do |budget| %>
            <% ltv = budget.loan_to_value_ratio(@market_rate.btc_eur_per_btc) %>
            <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
              <span>
                <%= t(".admin.active_budgets.row_html", id: budget.id, rate: number_with_delimiter(budget.peg_eur_per_btc)) %>
                <% if budget.maturity_block_height %>
                  <span class="text-muted small d-block">
                    <%= t(".admin.active_budgets.maturity_html",
                      height: number_with_delimiter(budget.maturity_block_height),
                      remaining: number_with_delimiter(budget.blocks_remaining)) %>
                  </span>
                <% end %>
                <% if ltv.present? %>
                  <%= budget_ltv_badge(budget, @market_rate.btc_eur_per_btc) %>
                <% end %>
              </span>
              <%= link_to t(".admin.active_budgets.action"), new_budget_settlement_path(budget),
                class: "btn btn-sm btn-danger #{'disabled' unless budget.ready_for_settlement?}",
                aria: { disabled: !budget.ready_for_settlement? } %>
            </li>
          <% end %>
        </ul>
      <% elsif @market_rate.set? %>
        <p class="text-muted mb-4"><%= t(".admin.active_budgets.empty") %></p>
      <% end %>

      <% unless @market_rate.set? %>
        <p class="text-muted mb-4"><%= t(".admin.market_rate.required") %></p>
      <% end %>

      <hr>
      <h2 class="h6"><%= t(".admin.wallets.title") %></h2>
      <p class="text-muted small mb-2">
        <%= t(".admin.wallets.description_html",
          wallet_name: L1::ExchangeWallet::DISPLAY_NAME,
          wallet_code: L1::ExchangeWallet::WALLET_NAME,
          blocks: L1::DepositReserveService::BLOCKS_PER_DEPOSIT) %>
      </p>

      <h3 class="h6 mt-3"><%= t(".admin.wallets.on_chain_title") %></h3>
      <% if @on_chain_wallets.available %>
        <% if @on_chain_wallets.rows.any? %>
          <div class="table-responsive mb-3">
            <table class="table table-sm table-striped align-middle mb-0">
              <thead>
                <tr>
                  <th><%= t(".admin.wallets.table.wallet") %></th>
                  <th><%= t(".admin.wallets.table.name") %></th>
                  <th class="text-end"><%= t(".admin.wallets.table.balance") %></th>
                  <th class="text-end"><%= t(".admin.wallets.table.eur") %></th>
                </tr>
              </thead>
              <tbody>
                <% @on_chain_wallets.rows.each do |row| %>
                  <tr>
                    <td><code><%= row.wallet_name %></code></td>
                    <td><%= row.label %></td>
                    <td class="text-end"><%= format_sats(row.sats) %></td>
                    <td class="text-end">
                      <% if row.eur.present? %>
                        <%= format_savings_eur(row.eur) %>
                      <% else %>
                        <span class="text-muted"><%= t("common.not_available") %></span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
              <tfoot>
                <tr class="fw-semibold">
                  <td colspan="2"><%= t(".admin.wallets.table.total") %></td>
                  <td class="text-end"><%= format_sats(@on_chain_wallets.total_sats) %></td>
                  <td class="text-end">
                    <% if @on_chain_wallets.total_eur.present? %>
                      <%= format_savings_eur(@on_chain_wallets.total_eur) %>
                    <% else %>
                      <span class="text-muted"><%= t("common.not_available") %></span>
                    <% end %>
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>
          <% unless @market_rate.set? %>
            <p class="text-muted small mb-0"><%= t(".admin.wallets.rate_required") %></p>
          <% end %>
        <% else %>
          <p class="text-muted small mb-3"><%= t(".admin.wallets.empty") %></p>
        <% end %>
      <% else %>
        <p class="text-warning small mb-3"><%= @on_chain_wallets.error_message %></p>
      <% end %>

      <hr>
      <%= button_to t(".admin.reset.button"),
        admin_demo_reset_path,
        method: :post,
        class: "btn btn-outline-danger btn-sm",
        data: { turbo_confirm: t(".admin.reset.confirm") } %>
    </div>
  </div>
<% end %>

<% unless admin? %>
  <h1 class="h3 mb-4"><%= t(".user.greeting", name: current_user.name) %></h1>

  <% if @margin_call_budgets.any? %>
    <div class="alert alert-warning">
      <strong><%= t(".user.margin_call.title", threshold: (Budget::MARGIN_CALL_LTV_THRESHOLD * 100).to_i) %></strong>
      <%= t(".user.margin_call.body", liquidation_threshold: (Budget::LIQUIDATION_LTV_THRESHOLD * 100).to_i) %>
      <ul class="mb-0 mt-2">
        <% @margin_call_budgets.each do |budget| %>
          <li><%= link_to t(".user.margin_call.budget_link", id: budget.id), budget %> - <%= t("dashboard.common.ltv_value", value: number_to_percentage(budget.loan_to_value_ratio(@market_rate.btc_eur_per_btc) * 100, precision: 0)) %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
<% end %>

<% unless admin? %>
<div class="row g-4 mb-4">
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-body">
        <h2 class="h6 text-muted"><%= t(".user.cards.reserve.title") %></h2>
        <% if @savings_eur.present? %>
          <p class="display-6 mb-1"><%= format_savings_eur(@savings_eur) %></p>
          <p class="text-muted mb-0">= <%= format_sats(@savings_sats) %></p>
        <% else %>
          <p class="display-6 mb-1"><%= format_sats(@savings_sats) %></p>
        <% end %>
        <% if current_user.btc_account.bitcoind_wallet_name.present? %>
          <p class="text-muted small mb-0 mt-1"><%= t(".user.cards.reserve.wallet_html", wallet: current_user.btc_account.bitcoind_wallet_name) %></p>
        <% else %>
          <p class="text-muted small mb-0 mt-1"><%= t(".user.cards.reserve.no_wallet") %></p>
        <% end %>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-body">
        <h2 class="h6 text-muted"><%= t(".user.cards.spending.title") %></h2>
        <% if @spending_budget_total_cents.positive? %>
          <p class="display-6 mb-0"><%= format_eur(@spending_budget_total_cents) %></p>
        <% else %>
          <p class="mb-0 text-muted"><%= t(".user.cards.spending.empty") %></p>
        <% end %>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-body">
        <h2 class="h6 text-muted"><%= t(".user.cards.investment.title") %></h2>
        <% if @investment_sats.positive? %>
          <% if @investment_eur.present? %>
            <p class="display-6 mb-1"><%= format_savings_eur(@investment_eur) %></p>
            <p class="text-muted mb-1">= <%= format_sats(@investment_sats) %></p>
          <% else %>
            <p class="display-6 mb-1"><%= format_sats(@investment_sats) %></p>
          <% end %>
          <% @investment_budgets.each do |budget| %>
            <p class="text-muted small mb-0"><%= t(".user.cards.investment.maturity", date: l(budget.period_end, format: :long)) %></p>
          <% end %>
        <% else %>
          <p class="mb-0 text-muted"><%= t(".user.cards.investment.empty") %></p>
        <% end %>
      </div>
    </div>
  </div>
</div>
<% if @rgb_node_error %>
  <div class="card mb-4 border-danger">
    <div class="card-header bg-danger-subtle"><%= t(".user.rgb.title") %></div>
    <div class="card-body">
      <p class="mb-0 text-danger"><%= t(".user.rgb.unavailable_html") %></p>
    </div>
  </div>
<% else %>
  <div class="card mb-4 border-primary">
    <div class="card-header bg-primary-subtle"><%= t(".user.rgb.title") %></div>
    <div class="card-body">
      <p class="text-muted small mb-3"><%= t(".user.rgb.description") %></p>
      <% if @rgb_assets.present? %>
        <ul class="list-group">
          <% @rgb_assets.each do |asset| %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <span>
                <strong><%= asset["ticker"] %></strong> - <%= asset["name"] %>
                <span class="text-muted small d-block"><code><%= asset["asset_id"] %></code></span>
              </span>
              <span class="badge text-bg-primary">
                <%= number_with_delimiter(asset.dig("balance", "settled") || asset.dig("balance", "future") || 0) %>
              </span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mb-0 text-muted"><%= t(".user.rgb.empty") %></p>
      <% end %>
    </div>
  </div>
<% end %>
<% end %>

<div class="d-flex gap-2 mb-4 flex-wrap">
  <% unless admin? %>
    <%= link_to t(".user.actions.deposit"), new_reserve_deposit_path, class: "btn btn-success" %>
    <%= link_to t(".user.actions.new_budget"), new_budget_path, class: "btn btn-primary" %>
    <% if @spendable_token_cents.positive? %>
      <%= link_to t(".user.actions.send_money"), new_token_transfer_path, class: "btn btn-outline-primary" %>
    <% else %>
      <span class="btn btn-outline-secondary disabled" aria-disabled="true"><%= t(".user.actions.send_money") %></span>
    <% end %>
  <% end %>
  <% if admin? %>
    <%= link_to t(".admin.actions.all_budgets"), budgets_path, class: "btn btn-outline-secondary" %>
  <% end %>
</div>

<% if @investable_budgets.any? %>
  <div class="card mb-4">
    <div class="card-header"><%= t(".user.investable.title") %></div>
    <div class="table-responsive">
      <table class="table mb-0">
        <thead>
          <tr>
            <th><%= t(".user.investable.table.borrower") %></th>
            <th><%= t(".user.investable.table.amount") %></th>
            <th><%= t(".user.investable.table.collateral") %></th>
            <th><%= t(".user.investable.table.current_rate") %></th>
            <th><%= t(".user.investable.table.period") %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @investable_budgets.each do |budget| %>
            <tr>
              <td><%= budget.borrower.name %></td>
              <td><%= format_eur(budget.amount_eur_cents) %></td>
              <td><%= format_eur(budget.collateral_eur_cents) %></td>
              <td><%= @market_rate.set? ? number_with_delimiter(@market_rate.btc_eur_per_btc) : t("common.not_available") %></td>
              <td><%= budget.period_start %> – <%= budget.period_end %></td>
              <td><%= link_to t(".user.investable.table.details"), budget, class: "btn btn-sm btn-outline-primary" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<% unless admin? %>
<div class="card">
  <div class="card-header"><%= t(".user.my_budgets.title") %></div>
  <div class="table-responsive">
    <table class="table mb-0">
      <thead>
        <tr>
          <th>ID</th>
          <th><%= t(".user.my_budgets.table.amount") %></th>
          <th><%= t(".user.my_budgets.table.status") %></th>
          <th><%= t(".user.my_budgets.table.maturity") %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if @borrowed_budgets.any? %>
          <% @borrowed_budgets.each do |budget| %>
            <tr>
              <td>#<%= budget.id %></td>
              <td><%= format_eur(budget.amount_eur_cents) %></td>
              <td><%= budget_status_badge(budget) %></td>
              <td>
                <%= l(budget.period_end, format: :long) %>
                <% if budget.maturity_block_height %>
                  <span class="text-muted d-block small"><%= t(".user.my_budgets.table.block", height: number_with_delimiter(budget.maturity_block_height)) %></span>
                <% end %>
              </td>
              <td><%= link_to t("common.actions.open"), budget, class: "btn btn-sm btn-outline-primary" %></td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="5" class="text-muted"><%= t(".user.my_budgets.empty") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="card mt-4">
  <div class="card-header"><%= t(".user.funds.title") %></div>
  <div class="table-responsive">
    <table class="table mb-0">
      <thead>
        <tr>
          <th><%= t(".user.funds.table.amount") %></th>
          <th><%= t(".user.funds.table.received") %></th>
          <th><%= t(".user.funds.table.maturity") %></th>
          <th><%= t(".user.funds.table.remaining_amount") %></th>
          <th><%= t(".user.funds.table.interest_at_maturity") %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if @my_fund_accounts.any? %>
          <% @my_fund_accounts.each do |account| %>
            <% budget = account.budget %>
            <% balance_cents = account.balance_cents %>
            <tr>
              <td><%= format_eur(fund_importo_cents(current_user, budget)) %></td>
              <td>
                <% received_at = first_token_received_at(current_user, budget) %>
                <%= received_at ? l(received_at, format: :long) : t("common.not_available") %>
              </td>
              <td>
                <%= l(budget.period_end, format: :long) %>
                <% if budget.maturity_block_height %>
                  <span class="text-muted d-block small"><%= t(".user.funds.table.block", height: number_with_delimiter(budget.maturity_block_height)) %></span>
                <% end %>
              </td>
              <td><%= balance_cents.positive? ? format_eur(balance_cents) : t("common.not_available") %></td>
              <td><%= balance_cents.positive? ? format_eur(budget.holder_interest_at_maturity_cents(balance_cents)) : t("common.not_available") %></td>
              <td><%= link_to t("common.actions.open"), budget, class: "btn btn-sm btn-outline-primary" %></td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6" class="text-muted"><%= t(".user.funds.empty") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
<% end %>
