<% if admin? %><span class="badge text-bg-info mb-4 d-inline-block">Admin</span><% end %>

<% if admin? %>
  <div class="card mb-4 border-info">
    <div class="card-header bg-info-subtle">Pannello admin</div>
    <div class="card-body">
      <h2 class="h6">Catena Bitcoin (simulata)</h2>
      <p class="text-muted small mb-3">
        Altezza blocco: <strong><%= number_with_delimiter(@market_rate.bitcoin_block_height) %></strong>
        — i deal si chiudono automaticamente al raggiungimento del blocco maturity.
      </p>

      <%= form_with url: admin_chain_state_path, method: :patch, class: "row g-2 align-items-end mb-4" do %>
        <div class="col-auto">
          <%= label_tag :bitcoin_block_height, "Altezza blocco", class: "form-label" %>
          <%= number_field_tag :bitcoin_block_height,
            @market_rate.bitcoin_block_height,
            class: "form-control form-control-sm",
            min: 0,
            step: 1,
            required: true %>
        </div>
        <div class="col-auto">
          <%= submit_tag "Aggiorna blocco", class: "btn btn-sm btn-outline-info" %>
        </div>
      <% end %>

      <h2 class="h6">Cambio BTC/€ corrente</h2>
      <%= form_with url: admin_market_rate_path, method: :patch, class: "row g-2 align-items-end mb-4" do %>
        <div class="col-auto">
          <%= label_tag :btc_eur_per_btc, "€/BTC", class: "form-label" %>
          <%= number_field_tag :btc_eur_per_btc,
            @market_rate.btc_eur_per_btc || 60_000,
            class: "form-control form-control-sm",
            step: 0.01,
            min: 0.01,
            required: true %>
        </div>
        <div class="col-auto">
          <%= submit_tag "Aggiorna cambio", class: "btn btn-sm btn-info" %>
        </div>
      <% end %>
      <% if @market_rate.set? %>
        <p class="text-muted small mb-4">Cambio attuale: <strong><%= number_with_delimiter(@market_rate.btc_eur_per_btc) %> €/BTC</strong></p>
      <% end %>

      <% if @active_budgets.any? %>
        <h2 class="h6">Budget attivi — settlement</h2>
        <ul class="list-group mb-4">
          <% @active_budgets.each do |budget| %>
            <% ltv = budget.loan_to_value_ratio(@market_rate.btc_eur_per_btc) %>
            <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
              <span>
                #<%= budget.id %> — peg <%= number_with_delimiter(budget.peg_eur_per_btc) %> €/BTC
                <% if budget.maturity_block_height %>
                  <span class="text-muted small d-block">
                    Maturity blocco <strong><%= number_with_delimiter(budget.maturity_block_height) %></strong>
                    (<%= number_with_delimiter(budget.blocks_remaining) %> rimanenti)
                  </span>
                <% end %>
                <% if ltv.present? %>
                  <%= budget_ltv_badge(budget, @market_rate.btc_eur_per_btc) %>
                <% end %>
              </span>
              <%= link_to "Settlement", new_budget_settlement_path(budget),
                class: "btn btn-sm btn-danger #{'disabled' unless budget.ready_for_settlement?}",
                aria: { disabled: !budget.ready_for_settlement? } %>
            </li>
          <% end %>
        </ul>
      <% elsif @market_rate.set? %>
        <p class="text-muted mb-4">Nessun budget attivo in attesa di settlement.</p>
      <% end %>

      <% unless @market_rate.set? %>
        <p class="text-muted mb-4">Imposta il cambio corrente per abilitare l'attivazione dei budget.</p>
      <% end %>

      <hr>
      <h2 class="h6">Multisig L1 (regtest)</h2>
      <% if l1_enabled? %>
        <p class="text-muted small mb-2">
          <span class="badge text-bg-success">L1_ENABLED</span>
          — wallet regtest per utente; depositi dal <%= L1::ExchangeWallet::DISPLAY_NAME %> (<code><%= L1::ExchangeWallet::WALLET_NAME %></code>).
          Ogni deposito avanza la catena simulata di <%= L1::DepositReserveService::BLOCKS_PER_DEPOSIT %> blocchi.
        </p>
      <% else %>
        <p class="text-muted small mb-2">
          Disabilitato. Avvia il server con <code>L1_ENABLED=1 bin/rails server</code> e <code>./bin/regtest up</code>.
        </p>
      <% end %>

      <hr>
      <h2 class="h6">Reset demo</h2>
      <p class="text-muted small">Cancella budget, token e settlement. Imposta Alice a 0.1 BTC, Bob a 0.2 BTC, gli altri a 0.</p>
      <%= button_to "Reset demo DB",
        admin_demo_reset_path,
        method: :post,
        class: "btn btn-outline-danger btn-sm",
        data: { turbo_confirm: "Confermi il reset? Tutti i budget e i token verranno eliminati." } %>
    </div>
  </div>
<% end %>

<% unless admin? %>
  <h1 class="h3 mb-4">Ciao, <%= current_user.name %></h1>

  <% if @margin_call_budgets.any? %>
    <div class="alert alert-warning">
      <strong>Margin call (LTV ≥ <%= (Budget::MARGIN_CALL_LTV_THRESHOLD * 100).to_i %>%):</strong>
      il collateral del deal non copre più adeguatamente gli EURT al cambio corrente.
      Versa collateral aggiuntivo per evitare la liquidazione automatica al <%= (Budget::LIQUIDATION_LTV_THRESHOLD * 100).to_i %>%.
      <ul class="mb-0 mt-2">
        <% @margin_call_budgets.each do |budget| %>
          <li><%= link_to "Ricarica ##{budget.id}", budget %> — LTV <%= number_to_percentage(budget.loan_to_value_ratio(@market_rate.btc_eur_per_btc) * 100, precision: 0) %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
<% end %>

<% unless admin? %>
<div class="row g-4 mb-4">
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-body">
        <h2 class="h6 text-muted">Conto di riserva (BTC)</h2>
        <% if @savings_eur.present? %>
          <p class="display-6 mb-1"><%= format_savings_eur(@savings_eur) %></p>
          <p class="text-muted mb-0">= <%= format_sats(@savings_sats) %></p>
        <% else %>
          <p class="display-6 mb-1"><%= format_sats(@savings_sats) %></p>
        <% end %>
        <% if l1_enabled? && current_user.btc_account.bitcoind_wallet_name.present? %>
          <p class="text-muted small mb-0 mt-1">Wallet regtest: <code><%= current_user.btc_account.bitcoind_wallet_name %></code></p>
        <% elsif l1_enabled? %>
          <p class="text-muted small mb-0 mt-1">Nessun wallet L1 — premi «Deposita su conto riserva».</p>
        <% elsif !@market_rate.set? %>
          <p class="text-muted small mb-0 mt-1">Cambio BTC/€ non impostato dall'admin.</p>
        <% end %>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-body">
        <h2 class="h6 text-muted">Conto corrente (spesa / risparmio)</h2>
        <% if @spending_budget_total_cents.positive? %>
          <p class="display-6 mb-0"><%= format_eur(@spending_budget_total_cents) %></p>
        <% else %>
          <p class="mb-0 text-muted">Nessun saldo sul conto corrente.</p>
        <% end %>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-body">
        <h2 class="h6 text-muted">Conto investimento</h2>
        <% if @investment_sats.positive? %>
          <% if @investment_eur.present? %>
            <p class="display-6 mb-1"><%= format_savings_eur(@investment_eur) %></p>
            <p class="text-muted mb-1">= <%= format_sats(@investment_sats) %></p>
          <% else %>
            <p class="display-6 mb-1"><%= format_sats(@investment_sats) %></p>
          <% end %>
          <% @investment_budgets.each do |budget| %>
            <p class="text-muted small mb-0">Scadenza: <%= l(budget.period_end, format: :long) %></p>
          <% end %>
        <% else %>
          <p class="mb-0 text-muted">Nessun deal attivo.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
<% end %>

<div class="d-flex gap-2 mb-4 flex-wrap">
  <% unless admin? %>
    <% if l1_enabled? %>
      <%= link_to "Deposita su conto riserva", new_reserve_deposit_path, class: "btn btn-success" %>
    <% end %>
    <%= link_to "Ricarica conto corrente", new_budget_path, class: "btn btn-primary" %>
    <% if @spendable_token_cents.positive? %>
      <%= link_to "Invia Denaro", new_token_transfer_path, class: "btn btn-outline-primary" %>
    <% else %>
      <span class="btn btn-outline-secondary disabled" aria-disabled="true">Invia Denaro</span>
    <% end %>
  <% end %>
  <% if admin? %>
    <%= link_to "Tutti i budget", budgets_path, class: "btn btn-outline-secondary" %>
  <% end %>
</div>

<% if @investable_budgets.any? %>
  <div class="card mb-4">
    <div class="card-header">Ricariche in attesa di investitore</div>
    <div class="table-responsive">
      <table class="table mb-0">
        <thead>
          <tr>
            <th>Richiedente</th>
            <th>Importo</th>
            <th>Collateral</th>
            <th>Cambio attuale</th>
            <th>Periodo</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @investable_budgets.each do |budget| %>
            <tr>
              <td><%= budget.borrower.name %></td>
              <td><%= format_eur(budget.amount_eur_cents) %></td>
              <td><%= format_eur(budget.collateral_eur_cents) %></td>
              <td><%= @market_rate.set? ? number_with_delimiter(@market_rate.btc_eur_per_btc) : "—" %></td>
              <td><%= budget.period_start %> – <%= budget.period_end %></td>
              <td><%= link_to "Dettagli", budget, class: "btn btn-sm btn-outline-primary" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<% unless admin? %>
<div class="card">
  <div class="card-header">Le mie ricariche</div>
  <div class="table-responsive">
    <table class="table mb-0">
      <thead>
        <tr>
          <th>ID</th>
          <th>Importo</th>
          <th>Stato</th>
          <th>Scadenza</th>
          <th>Importo rimanente</th>
          <th>Interessi alla scadenza</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @borrowed_budgets.each do |budget| %>
          <% balance_cents = ricarica_balance_cents(budget, current_user) %>
          <tr>
            <td>#<%= budget.id %></td>
            <td><%= format_eur(budget.amount_eur_cents) %></td>
            <td><%= budget_status_badge(budget) %></td>
            <td>
              <%= l(budget.period_end, format: :long) %>
              <% if budget.maturity_block_height %>
                <span class="text-muted d-block small">blocco <%= number_with_delimiter(budget.maturity_block_height) %></span>
              <% end %>
            </td>
            <td><%= balance_cents.positive? ? format_eur(balance_cents) : "—" %></td>
            <td><%= balance_cents.positive? ? format_eur(budget.holder_interest_at_maturity_cents(balance_cents)) : "—" %></td>
            <td><%= link_to "Apri", budget, class: "btn btn-sm btn-outline-primary" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="card mt-4">
  <div class="card-header">I miei fondi</div>
  <div class="table-responsive">
    <table class="table mb-0">
      <thead>
        <tr>
          <th>Importo</th>
          <th>Ricevuto</th>
          <th>Scadenza</th>
          <th>Importo rimanente</th>
          <th>Interessi alla scadenza</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if @my_fund_accounts.any? %>
          <% @my_fund_accounts.each do |account| %>
            <% budget = account.budget %>
            <% balance_cents = account.balance_cents %>
            <tr>
              <td><%= format_eur(received_token_amount_cents(current_user, budget)) %></td>
              <td>
                <% received_at = first_token_received_at(current_user, budget) %>
                <%= received_at ? l(received_at, format: :long) : "—" %>
              </td>
              <td>
                <%= l(budget.period_end, format: :long) %>
                <% if budget.maturity_block_height %>
                  <span class="text-muted d-block small">blocco <%= number_with_delimiter(budget.maturity_block_height) %></span>
                <% end %>
              </td>
              <td><%= balance_cents.positive? ? format_eur(balance_cents) : "—" %></td>
              <td><%= balance_cents.positive? ? format_eur(budget.holder_interest_at_maturity_cents(balance_cents)) : "—" %></td>
              <td><%= link_to "Apri", budget, class: "btn btn-sm btn-outline-primary" %></td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6" class="text-muted">Nessun token EURT ricevuto.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
<% end %>
