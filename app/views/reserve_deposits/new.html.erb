<h1 class="h3 mb-4"><%= t(".title") %></h1>

<%# Phase 2: Show stored receive address (set by mobile client) %>
<% if @receive_address.present? %>
  <div class="card mb-4 border-secondary">
    <div class="card-body">
      <h2 class="h6"><%= t(".receive_address.title") %></h2>
      <p class="text-muted small">Your on-device wallet address (Phase 2 BDK)</p>
      <p class="mb-0">
        <input type="text"
          class="form-control form-control-sm font-monospace"
          value="<%= @receive_address %>"
          readonly
          onclick="this.select()"
          aria-label="<%= t('.receive_address.title') %>">
      </p>
    </div>
  </div>
<% else %>
  <div class="alert alert-warning">
    No receive address registered. Create a wallet in the mobile app first (Phase 2 BDK).
  </div>
<% end %>

<div class="card mb-4">
  <div class="card-body">
    <p class="text-muted">
      Test funding from the Exchange wallet. In production, users receive real BTC to their on-device wallets.
    </p>

    <%= form_with url: reserve_deposit_path, method: :post, class: "row g-3 align-items-end" do %>
      <div class="col-auto">
        <%= label_tag :amount_btc, t(".form.amount"), class: "form-label" %>
        <%= number_field_tag :amount_btc, @amount_btc,
          class: "form-control",
          step: 0.00000001,
          min: 0.00000001,
          required: true,
          disabled: @receive_address.blank? %>
        <div class="form-text">Amount in BTC</div>
      </div>
      <div class="col-auto">
        <%= submit_tag t(".form.submit"), class: "btn btn-success", disabled: @receive_address.blank? %>
      </div>
    <% end %>
  </div>
</div>

<%= link_to t("common.actions.back_to_dashboard"), root_path, class: "btn btn-link px-0" %>
