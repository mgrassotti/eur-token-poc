<h1 class="h3 mb-4"><%= t(".title") %></h1>

<% begin %>
  <% @receive_address = L1::ReserveReceiveAddressService.ensure!(user: current_user) %>
  <div class="card mb-4 border-secondary">
    <div class="card-body">
      <h2 class="h6"><%= t(".receive_address.title") %></h2>
      <p class="text-muted small"><%= t(".receive_address.note_html", wallet_name: L1::ExchangeWallet::DISPLAY_NAME) %></p>
      <p class="mb-0">
        <input type="text"
          class="form-control form-control-sm font-monospace"
          value="<%= @receive_address %>"
          readonly
          onclick="this.select()"
          aria-label="<%= t('.receive_address.title') %>">
      </p>
    </div>
  </div>
<% rescue L1::ReserveReceiveAddressService::Error => e %>
  <div class="alert alert-warning"><%= e.message %></div>
<% end %>

<div class="card mb-4">
  <div class="card-body">
    <p class="text-muted">
      <%= t(".description_html",
        wallet_name: L1::ExchangeWallet::DISPLAY_NAME,
        wallet_code: L1::ExchangeWallet::WALLET_NAME,
        float_balance: BtcConversion.format_btc(L1::ExchangeWallet::INITIAL_BALANCE_SATS),
        blocks: L1::DepositReserveService::BLOCKS_PER_DEPOSIT) %>
    </p>

    <%= form_with url: reserve_deposit_path, method: :post, class: "row g-3 align-items-end" do %>
      <div class="col-auto">
        <%= label_tag :amount_btc, t(".form.amount"), class: "form-label" %>
        <%= number_field_tag :amount_btc, @amount_btc,
          class: "form-control",
          step: 0.00000001,
          min: 0.00000001,
          required: true %>
        <div class="form-text"><%= t(".form.default_values") %></div>
      </div>
      <div class="col-auto">
        <%= submit_tag t(".form.submit"), class: "btn btn-success" %>
      </div>
    <% end %>
  </div>
</div>

<%= link_to t("common.actions.back_to_dashboard"), root_path, class: "btn btn-link px-0" %>
