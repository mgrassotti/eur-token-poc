<h1 class="h3 mb-4">Deposita su conto di riserva</h1>

<div class="card mb-4">
  <div class="card-body">
    <p class="text-muted">
      Simula un bonifico BTC dal <strong><%= L1::ExchangeWallet::DISPLAY_NAME %></strong> (<code><%= L1::ExchangeWallet::WALLET_NAME %></code>,
      float demo <%= BtcConversion.format_btc(L1::ExchangeWallet::INITIAL_BALANCE_SATS) %>) verso il tuo wallet regtest personale.
      Alla conferma la <strong>catena simulata</strong> avanza di <%= L1::DepositReserveService::BLOCKS_PER_DEPOSIT %> blocchi.
    </p>

    <%= form_with url: reserve_deposit_path, method: :post, class: "row g-3 align-items-end" do %>
      <div class="col-auto">
        <%= label_tag :amount_btc, "Importo (BTC)", class: "form-label" %>
        <%= number_field_tag :amount_btc, @amount_btc,
          class: "form-control",
          step: 0.00000001,
          min: 0.00000001,
          required: true %>
        <div class="form-text">Default demo: Alice 0,1 · Bob 0,2 BTC</div>
      </div>
      <div class="col-auto">
        <%= submit_tag "Conferma deposito", class: "btn btn-success" %>
      </div>
    <% end %>
  </div>
</div>

<%= link_to "← Dashboard", root_path, class: "btn btn-link px-0" %>
