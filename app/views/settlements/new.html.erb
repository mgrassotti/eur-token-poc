<h1 class="h3 mb-4"><%= t(".title") %></h1>

<p class="text-muted"><%= t(".description", id: @budget.id) %></p>

<div class="card">
  <div class="card-body">
    <%= form_with url: budget_settlement_path(@budget), method: :post do %>
      <div class="mb-3">
        <%= label_tag :end_btc_eur_rate, t(".form.end_rate"), class: "form-label" %>
        <%= number_field_tag :end_btc_eur_rate,
          @market_rate.btc_eur_per_btc || 60_000,
          class: "form-control",
          step: 0.01,
          min: 0.01,
          required: true %>
        <div class="form-text">
          <%= t(".form.help_intro", rate: number_with_delimiter(@budget.peg_eur_per_btc)) %>
          <% if @market_rate.set? %>
            <%= t(".form.current_dashboard_rate", rate: number_with_delimiter(@market_rate.btc_eur_per_btc)) %>
          <% end %>
          <%= t(".form.payout_note", borrower: @budget.borrower.name, investor: @budget.investor.name) %>
        </div>
      </div>
      <%= submit_tag t(".form.submit"), class: "btn btn-danger", data: { turbo_confirm: t(".form.confirm") } %>
      <%= link_to t("common.actions.cancel"), @budget, class: "btn btn-link" %>
    <% end %>
  </div>
</div>
