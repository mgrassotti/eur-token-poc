#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

if ! curl -sf --user regtest:regtest \
  --data-binary '{"jsonrpc":"1.0","id":1,"method":"getblockchaininfo","params":[]}' \
  -H "content-type: application/json" \
  http://127.0.0.1:18443/ >/dev/null 2>&1; then
  echo "→ Avvio bitcoind regtest…"
  ./bin/regtest up
fi

exec bundle exec rspec spec/integration/demo_end_to_end_flow_spec.rb --format documentation "$@"
