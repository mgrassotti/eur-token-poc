#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

# MVP savings: bitcoind + electrs (BDK) + DLC oracle/sidecar. RGB/LN is opt-in.
PROFILE_ARGS=(--profile dlc)
if [[ "${1:-}" == "--rgb" ]]; then
  PROFILE_ARGS=(--profile rgb --profile dlc)
  shift
fi

wait_for_electrs() {
  echo "Waiting for electrs on :50001..."
  for _ in $(seq 1 60); do
    if (echo > /dev/tcp/127.0.0.1/50001) >/dev/null 2>&1; then
      echo "electrs ready"
      return 0
    fi
    sleep 1
  done
  echo "electrs did not become ready in time" >&2
  exit 1
}

wait_for_pythia() {
  echo "Waiting for Pythia on :8000..."
  for _ in $(seq 1 60); do
    if curl -sf http://127.0.0.1:8000/v1/oracle/publickey >/dev/null 2>&1; then
      echo "Pythia ready"
      return 0
    fi
    sleep 1
  done
  echo "Pythia did not become ready in time (DLC stack still starting)" >&2
}

case "${1:-up}" in
  up)
    docker compose -f docker-compose.regtest.yml "${PROFILE_ARGS[@]}" up -d --build
    echo "Waiting for bitcoind regtest on :18443..."
    for _ in $(seq 1 60); do
      if curl -sf --user regtest:regtest \
        --data-binary '{"jsonrpc":"1.0","id":1,"method":"getblockchaininfo","params":[]}' \
        -H "content-type: application/json" \
        http://127.0.0.1:18443/ >/dev/null 2>&1; then
        echo "bitcoind regtest ready"
        wait_for_electrs
        wait_for_pythia
        exit 0
      fi
      sleep 1
    done
    echo "bitcoind did not become ready in time" >&2
    exit 1
    ;;
  down)
    docker compose -f docker-compose.regtest.yml --profile dlc --profile rgb down
    ;;
  reset)
    docker compose -f docker-compose.regtest.yml --profile dlc --profile rgb down
    exec "$0" up
    ;;
  logs)
    docker compose -f docker-compose.regtest.yml logs -f bitcoind
    ;;
  *)
    echo "Usage: $0 [--rgb] {up|down|reset|logs}" >&2
    exit 1
    ;;
esac
