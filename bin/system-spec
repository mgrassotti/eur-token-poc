#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

bitcoind_up() {
  curl -sf --user regtest:regtest \
    --data-binary '{"jsonrpc":"1.0","id":1,"method":"getblockchaininfo","params":[]}' \
    -H "content-type: application/json" \
    http://127.0.0.1:18443/ >/dev/null 2>&1
}

rln_up() {
  curl -s -o /dev/null http://127.0.0.1:3001/nodeinfo >/dev/null 2>&1
}

if ! bitcoind_up || ! rln_up; then
  echo "→ Avvio regtest + RGB Lightning Nodes…"
  ./bin/regtest up
fi

exec bundle exec rspec spec/system/demo_end_to_end_flow_spec.rb --format documentation "$@"
